msgid "Fan Control Settings"
msgstr "风扇控制设置"

msgid "Configure the parameters for the fan control service."
msgstr "配置风扇控制服务的相关参数。"

msgid "General"
msgstr "常规"

msgid "Enable Service"
msgstr "启用服务"

msgid "Thermal File Path"
msgstr "温度文件路径"

msgid "Fan Control File Path"
msgstr "风扇控制文件路径"

msgid "Initial Speed"
msgstr "启动初始速度"

msgid "Max Speed"
msgstr "最大速度"

msgid "Start Temperature (°C)"
msgstr "启动温度 (°C)"

msgid "Live Status"
msgstr "实时状态"

msgid "Service Status"
msgstr "服务状态"

msgid "CPU Temperature"
msgstr "CPU 温度"

msgid "Fan Speed Level"
msgstr "风扇转速等级"

msgid "Loading..."
msgstr "正在加载..."

msgid "Running"
msgstr "运行中"

msgid "Stopped"
msgstr "已停止"

msgid "Invalid"
msgstr "无效"

msgid "N/A"
msgstr "不可用"

msgid "Fan General Control"
msgstr "通用风扇控制小程序"

msgid "The minimum speed level when the fan is running."
msgstr "风扇运行时，风扇的最低速度等级。"

msgid "The maximum speed level of the fan."
msgstr "风扇的最大速度等级。"

msgid "When the temperature reaches this value, the fan starts spinning."
msgstr "当温度达到这个值时，风扇开始转动。"

msgid "Max Temperature (°C)"
msgstr "全速温度 (°C)"

msgid "The temperature at which the fan should run at maximum speed."
msgstr "当温度达到这个值时，风扇应全速运转。"

msgid "Hysteresis Temperature (°C)"
msgstr "回差温度 (°C)"

msgid "Unknown"
msgstr "未知"

msgid "Debug Logging"
msgstr "调试日志"

msgid "Log the temperature and target speed to syslog on every poll."
msgstr "每次轮询都把温度与目标转速写入 syslog。"

msgid "Temperature Divisor"
msgstr "温度除数"

msgid "The raw sensor value is divided by this to get degrees Celsius."
msgstr "原始温度读数除以该数值后得到摄氏度。"

msgid "Read failed"
msgstr "读取失败"

msgid "Check that the path exists and is allowed by the ACL."
msgstr "请确认该路径存在，且在本应用允许访问的范围内。"

msgid "The fan will not stop until the temperature drops below (Start Temperature - Hysteresis)."
msgstr "只有当温度降至 (启动温度 - 回差温度) 以下时，风扇才会停止。"
